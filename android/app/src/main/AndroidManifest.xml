<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- COARSE must be requested alongside FINE: on Android 12+ the OS
         silently ignores a runtime request for ACCESS_FINE_LOCATION alone on
         some releases (logcat: "ACCESS_FINE_LOCATION must be requested with
         ACCESS_COARSE_LOCATION"), so the precise-location dialog may never
         appear without it. permission_handler builds its request list from
         whichever of the two are declared here, so this alone makes it
         request both together. See
         https://developer.android.com/develop/sensors-and-location/location/permissions/runtime -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Optional in practice, not load-bearing for how tracking works today:
         recording is always started while the app is in the foreground, and
         a foreground service with foregroundServiceType="location" keeps
         full location access once the screen turns off / the app backgrounds
         WITHOUT this permission (Android only requires it to *start* such a
         service from the background — see
         https://developer.android.com/develop/sensors-and-location/location/permissions).
         Declared anyway, and requested as a purely optional permission (see
         permission_data_source.dart / Permission.locationAlways) purely as a
         defensive measure: some OEM battery managers key their whitelisting
         heuristics off "Allow all the time" being granted. NOT kept as a
         stepping stone toward a native kill-survival service — that
         architecture was evaluated and explicitly rejected as disproportionate
         maintenance cost for this project, see AUDIT-2026-07.md §2. Re-evaluate
         (possible removal) if the OEM-whitelisting hypothesis turns out to
         have no measurable effect. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- On Android 13+ a foreground service does NOT need this permission to
         run, but WITHOUT it the "Recording activity" notification is not
         shown in the notification drawer (it only appears in the Android 13+
         Task Manager) — the user loses the visible signal that a run is being
         tracked, and the setOngoing anti-swipe-kill mitigation below becomes
         invisible. See
         https://developer.android.com/develop/ui/views/notifications/notification-permission
         Requested at runtime as an optional permission (see
         permission_data_source.dart); a denial does not block recording. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Declared so geolocator's foreground service can hold a partial wake
         lock (enableWakeLock: true) and keep delivering GPS fixes while the
         screen is off and the device is in Doze. The geolocator_android
         manifest also declares it; this makes the dependency explicit. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the app ask the user to exempt it from battery optimisation
         (Doze / App Standby). Without the exemption, aggressive OEM battery
         managers (Xiaomi/MIUI, Samsung, Huawei, ...) can kill the foreground
         service process while the phone is locked, silently ending a
         recording. The permission only allows *requesting* the exemption via
         the system dialog; the user still decides. Google Play restricts this
         permission, but Furtive is distributed outside Play (GitHub / F-Droid)
         where a continuous location tracker is exactly the sanctioned use. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:label="furtive"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
